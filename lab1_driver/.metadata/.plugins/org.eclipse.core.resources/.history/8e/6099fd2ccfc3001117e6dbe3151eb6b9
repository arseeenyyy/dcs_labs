#ifndef MY_GPIO_H
#define MY_GPIO_H

#include <stdint.h>
#include "stm32f4xx.h"

// режимы работы пина
typedef enum {
    MY_GPIO_MODE_INPUT  = 0x00u,
    MY_GPIO_MODE_OUTPUT = 0x01u,
    MY_GPIO_MODE_AF     = 0x02u,
    MY_GPIO_MODE_ANALOG = 0x03u
} my_gpio_mode_t;

/* Тип выхода (OTYPER) */
typedef enum {
    MY_GPIO_OTYPE_PP = 0x0u,  /* Push-pull  */
    MY_GPIO_OTYPE_OD = 0x1u   /* Open-drain */
} my_gpio_otype_t;

/* Скорость (OSPEEDR) */
typedef enum {
    MY_GPIO_SPEED_LOW       = 0x0u,
    MY_GPIO_SPEED_MEDIUM    = 0x1u,
    MY_GPIO_SPEED_HIGH      = 0x2u,
    MY_GPIO_SPEED_VERY_HIGH = 0x3u
} my_gpio_speed_t;

/* Подтяжка (PUPDR) */
typedef enum {
    MY_GPIO_PULL_NONE = 0x0u,
    MY_GPIO_PULL_UP   = 0x1u,
    MY_GPIO_PULL_DOWN = 0x2u
} my_gpio_pull_t;

/* Порт — указатель на структуру регистров (GPIOA, GPIOB, ...) */
typedef GPIO_TypeDef* my_gpio_port_t;

/* Включить тактирование порта (по указателю). */
void my_gpio_enable_clock(my_gpio_port_t port);

/* Инициализация одного пина. pin: 0..15.
   Возвращает 0 при успехе, -1 при ошибке. */
int my_gpio_init(my_gpio_port_t port, uint8_t pin,
                 my_gpio_mode_t mode,
                 my_gpio_otype_t otype,
                 my_gpio_speed_t speed,
                 my_gpio_pull_t pull);

/* Прочитать текущие настройки пина (любой указатель может быть NULL). */
int my_gpio_get_config(my_gpio_port_t port, uint8_t pin,
                       my_gpio_mode_t  *mode,
                       my_gpio_otype_t *otype,
                       my_gpio_speed_t *speed,
                       my_gpio_pull_t  *pull);

/* Записать один пин: value = 0 или 1. */
void my_gpio_write_pin(my_gpio_port_t port, uint8_t pin, uint8_t value);

/* Прочитать один пин: возвращает 0 или 1. */
uint8_t my_gpio_read_pin(my_gpio_port_t port, uint8_t pin);

/* Записать сразу несколько пинов порта (маска, младший бит = пин 0). */
void my_gpio_write_port(my_gpio_port_t port, uint16_t mask);

/* Прочитать сразу все 16 пинов порта. */
uint16_t my_gpio_read_port(my_gpio_port_t port);

#endif /* MY_GPIO_H */
